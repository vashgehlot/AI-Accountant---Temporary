# Copy this file to .env (git-ignored) and paste one key. With an OpenRouter key
# (https://openrouter.ai/keys) uploaded documents are sent to OpenRouter; without one, to Groq
# (https://console.groq.com/keys). Both read them with the same model.
# A line starting with # shows a setting's default: remove the # to change it.
OPENROUTER_API_KEY=
# This one model both reads the uploaded files and runs the accountant chat, so it must take images and support tool
# calls. The chat runs through OpenRouter only: with just a Groq key the files are read, but the chat is unavailable.
# OPENROUTER_MODEL=qwen/qwen3.8-27b
# Another OpenRouter model for the accountant chat and the background review than the one that reads the files.
# It must call tools, for example anthropic/claude-haiku-5.5. Empty: OPENROUTER_MODEL does both.
# OPENROUTER_CHAT_MODEL=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MAX_OUTPUT_TOKENS=32768
# OpenRouter asks this full-precision host first, then any host at these precisions, for reading the files and
# for the chat alike; never a 4-bit one, which left a line out of an expense claim every time. Blank
# OPENROUTER_PROVIDERS lets OpenRouter choose.
# OPENROUTER_PROVIDERS=deepinfra/bf16
# OPENROUTER_QUANTIZATIONS=bf16,fp16,fp32,fp8
# How a document is read, on either provider: seconds the model may send nothing (a streamed answer still
# arriving is never cut off), seconds a read may take in all (a long bank statement can take several minutes), the
# model's thinking (none, low, high), and scanned pages per request.
# OPENROUTER_TIMEOUT=200.0
# OPENROUTER_TOTAL_TIMEOUT=600.0
# OPENROUTER_REASONING_EFFORT=high
# OPENROUTER_MAX_IMAGES=3
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MAX_OUTPUT_TOKENS=8192
# The names three of the settings above had before; still read when the new name isn't set.
# GROQ_TIMEOUT=200.0
# GROQ_REASONING_EFFORT=high
# GROQ_MAX_IMAGES=3

# Everything is kept in MongoDB, and the API will not start without its address,
# e.g. mongodb://localhost:27017 (or your Atlas connection string).
MONGODB_URI=
# MONGODB_DB_NAME=ledgersync
# The most connections the API keeps to MongoDB (Atlas M0 allows 500 in all, counted on each node).
# LEDGERSYNC_MONGO_MAX_POOL=10
# The tests run against a separate MongoDB, in throwaway databases, and need this address:
# LEDGERSYNC_TEST_MONGODB_URI=mongodb://localhost:27017

# Whose books these are (tells sales invoices from purchase invoices), e.g. Northbridge Consulting Ltd
LEDGERSYNC_BUSINESS_NAME=
# LEDGERSYNC_HOST=127.0.0.1
# LEDGERSYNC_PORT=8085
# LEDGERSYNC_RELOAD=0
# LEDGERSYNC_WARMUP=1
# LEDGERSYNC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# LEDGERSYNC_MAX_UPLOAD_MB=20
# LEDGERSYNC_MAX_PDF_PAGES=30
# LEDGERSYNC_MAX_PARALLEL_JOBS=5
# LEDGERSYNC_LOG_LEVEL=INFO

# The seconds one answer of the accountant chat may take (it runs on OPENROUTER_MODEL).
# LEDGERSYNC_AGENT_TIMEOUT=60
# 1 offers the demo's reset (Northbridge Consulting Ltd, POST /api/demo/reset).
# LEDGERSYNC_DEMO=0

# Seconds after a client's last change before the background AI review starts.
# LEDGERSYNC_REVIEW_WAIT=20
# Background AI reviews one client may have in a day.
# LEDGERSYNC_REVIEW_DAILY_LIMIT=20
# 0 keeps the API from running the background AI review (it also needs LEDGERSYNC_WARMUP=1).
# LEDGERSYNC_REVIEW_WORKER=1
